# Copy to .env (git-ignored) and fill in. Never commit real values.

# PostgreSQL
DB_NAME=portal
DB_USER=portal
DB_PASSWORD=

# Backend (prod profile). SESSION_SECRET is required; generate with: openssl rand -hex 32
SESSION_SECRET=
# Committee admin, created only on the first start when no admin exists. Password must be 12+ characters.
ADMIN_EMAIL=admin@society.test
ADMIN_PASSWORD=

# Published port of the web container
WEB_PORT=8081
