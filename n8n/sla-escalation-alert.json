{
  "id": "shslaescalationale",
  "name": "Sahyadri: SLA escalation alert",
  "nodes": [
    {
      "id": "n17",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "n18",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "portal_url",
              "type": "string",
              "value": "https://YOUR-PORTAL-URL"
            },
            {
              "id": "c2",
              "name": "webhook_secret",
              "type": "string",
              "value": "PASTE-SECRET-FROM-SETTINGS-AI-AND-WHATSAPP"
            },
            {
              "id": "c3",
              "name": "admin_email",
              "type": "string",
              "value": "admin@society.test"
            },
            {
              "id": "c4",
              "name": "admin_password",
              "type": "string",
              "value": "PASTE-ADMIN-PASSWORD"
            },
            {
              "id": "c5",
              "name": "whatsapp_phone_id",
              "type": "string",
              "value": "PASTE-WHATSAPP-PHONE-NUMBER-ID"
            },
            {
              "id": "c6",
              "name": "whatsapp_token",
              "type": "string",
              "value": "PASTE-WHATSAPP-ACCESS-TOKEN"
            },
            {
              "id": "c7",
              "name": "committee_whatsapp",
              "type": "string",
              "value": "91XXXXXXXXXX"
            }
          ]
        }
      }
    },
    {
      "id": "n19",
      "name": "Portal login",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $(\"Config\").item.json.portal_url }}/api/login",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ email: $(\"Config\").item.json.admin_email, password: $(\"Config\").item.json.admin_password }) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": false
            }
          }
        }
      }
    },
    {
      "id": "n20",
      "name": "Pick session cookie",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "jsCode": "const sc = $input.first().json.headers['set-cookie'];\nconst arr = Array.isArray(sc) ? sc : [sc];\nreturn [{ json: { cookie: arr.filter(Boolean).map(c => c.split(';')[0]).join('; ') } }];"
      }
    },
    {
      "id": "n21",
      "name": "Run escalation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $(\"Config\").item.json.portal_url }}/api/admin/escalations/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Cookie",
              "value": "={{ $json.cookie }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={}",
        "options": {}
      }
    },
    {
      "id": "n22",
      "name": "Anything escalated?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "e1",
              "leftValue": "={{ $json.escalated }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n23",
      "name": "Alert the committee",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        -80
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $(\"Config\").item.json.whatsapp_phone_id }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $(\"Config\").item.json.whatsapp_token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $(\"Config\").item.json.committee_whatsapp, type: 'text', text: { body: 'Escalated: ' + $json.escalated + ' request(s) passed the SLA. Open the portal dashboard to assign vendors.' } }) }}",
        "options": {}
      }
    },
    {
      "id": "n24",
      "name": "Nothing to do",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1440,
        100
      ],
      "parameters": {}
    },
    {
      "id": "n25",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -200
      ],
      "parameters": {
        "content": "## SLA escalation\nThe portal also escalates on its own every 10 minutes. This workflow runs the check on a schedule you control and pings the committee on WhatsApp only when something was escalated.",
        "height": 160,
        "width": 520
      }
    }
  ],
  "connections": {
    "Every 15 minutes": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Portal login",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Portal login": {
      "main": [
        [
          {
            "node": "Pick session cookie",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pick session cookie": {
      "main": [
        [
          {
            "node": "Run escalation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run escalation": {
      "main": [
        [
          {
            "node": "Anything escalated?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Anything escalated?": {
      "main": [
        [
          {
            "node": "Alert the committee",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Nothing to do",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "pinData": {},
  "tags": []
}