<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="defs_asis_complaint" targetNamespace="http://sahyadri-heights.example/bpmn" exporter="hand-authored" exporterVersion="1.0">
  <collaboration id="collab_asis_complaint">
    <participant id="part_asis_complaint" name="As-is: resident complaint (WhatsApp groups, paper register, phone)" processRef="asis_complaint"/>
  </collaboration>
  <process id="asis_complaint" name="As-is: resident complaint (WhatsApp groups, paper register, phone)" isExecutable="false">
    <laneSet id="ls_asis_complaint">
      <lane id="l_res" name="Resident">
        <flowNodeRef>s1</flowNodeRef>
        <flowNodeRef>t1</flowNodeRef>
        <flowNodeRef>t4</flowNodeRef>
        <flowNodeRef>g2</flowNodeRef>
        <flowNodeRef>e1</flowNodeRef>
      </lane>
      <lane id="l_sec" name="Security desk / office staff">
        <flowNodeRef>t2</flowNodeRef>
      </lane>
      <lane id="l_com" name="Committee member">
        <flowNodeRef>t3</flowNodeRef>
        <flowNodeRef>g1</flowNodeRef>
        <flowNodeRef>t5</flowNodeRef>
      </lane>
      <lane id="l_ven" name="Vendor">
        <flowNodeRef>t6</flowNodeRef>
        <flowNodeRef>t7</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="s1" name="Problem noticed"><outgoing>f_asis_complaint_1</outgoing></startEvent>
    <task id="t1" name="Post in WhatsApp group or phone a committee member"><incoming>f_asis_complaint_1</incoming><outgoing>f_asis_complaint_2</outgoing></task>
    <task id="t2" name="Write complaint in paper register at office"><incoming>f_asis_complaint_2</incoming><outgoing>f_asis_complaint_3</outgoing></task>
    <task id="t3" name="Read group chat or register and notice the complaint (missed if scrolled past)"><incoming>f_asis_complaint_3</incoming><incoming>f_asis_complaint_7</incoming><outgoing>f_asis_complaint_4</outgoing></task>
    <exclusiveGateway id="g1" name="Seen by a committee member?"><incoming>f_asis_complaint_4</incoming><outgoing>f_asis_complaint_5</outgoing><outgoing>f_asis_complaint_6</outgoing></exclusiveGateway>
    <task id="t4" name="Resident follows up by phone or in the group"><incoming>f_asis_complaint_6</incoming><outgoing>f_asis_complaint_7</outgoing></task>
    <task id="t5" name="Phone a vendor from personal contacts"><incoming>f_asis_complaint_5</incoming><outgoing>f_asis_complaint_8</outgoing></task>
    <task id="t6" name="Visit flat and fix the problem"><incoming>f_asis_complaint_8</incoming><outgoing>f_asis_complaint_9</outgoing></task>
    <task id="t7" name="Tell committee verbally; tick register by hand (rarely)"><incoming>f_asis_complaint_9</incoming><outgoing>f_asis_complaint_10</outgoing></task>
    <exclusiveGateway id="g2" name="Resident informed?"><incoming>f_asis_complaint_10</incoming><outgoing>f_asis_complaint_11</outgoing></exclusiveGateway>
    <endEvent id="e1" name="Complaint forgotten (no record, no rating)"><incoming>f_asis_complaint_11</incoming></endEvent>
    <sequenceFlow id="f_asis_complaint_1" sourceRef="s1" targetRef="t1"/>
    <sequenceFlow id="f_asis_complaint_2" sourceRef="t1" targetRef="t2"/>
    <sequenceFlow id="f_asis_complaint_3" sourceRef="t2" targetRef="t3"/>
    <sequenceFlow id="f_asis_complaint_4" sourceRef="t3" targetRef="g1"/>
    <sequenceFlow id="f_asis_complaint_5" sourceRef="g1" targetRef="t5" name="Yes"/>
    <sequenceFlow id="f_asis_complaint_6" sourceRef="g1" targetRef="t4" name="No"/>
    <sequenceFlow id="f_asis_complaint_7" sourceRef="t4" targetRef="t3"/>
    <sequenceFlow id="f_asis_complaint_8" sourceRef="t5" targetRef="t6"/>
    <sequenceFlow id="f_asis_complaint_9" sourceRef="t6" targetRef="t7"/>
    <sequenceFlow id="f_asis_complaint_10" sourceRef="t7" targetRef="g2"/>
    <sequenceFlow id="f_asis_complaint_11" sourceRef="g2" targetRef="e1"/>
  </process>
  <bpmndi:BPMNDiagram id="diag_asis_complaint">
    <bpmndi:BPMNPlane id="plane_asis_complaint" bpmnElement="collab_asis_complaint">
      <bpmndi:BPMNShape id="sh_part_asis_complaint" bpmnElement="part_asis_complaint" isHorizontal="true"><omgdc:Bounds x="30" y="20" width="1740" height="640"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_l_res" bpmnElement="l_res" isHorizontal="true"><omgdc:Bounds x="60" y="20" width="1710" height="160"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_l_sec" bpmnElement="l_sec" isHorizontal="true"><omgdc:Bounds x="60" y="180" width="1710" height="160"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_l_com" bpmnElement="l_com" isHorizontal="true"><omgdc:Bounds x="60" y="340" width="1710" height="160"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_l_ven" bpmnElement="l_ven" isHorizontal="true"><omgdc:Bounds x="60" y="500" width="1710" height="160"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_s1" bpmnElement="s1"><omgdc:Bounds x="232" y="82" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_t1" bpmnElement="t1"><omgdc:Bounds x="345" y="65" width="110" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_t2" bpmnElement="t2"><omgdc:Bounds x="495" y="225" width="110" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_t3" bpmnElement="t3"><omgdc:Bounds x="645" y="385" width="110" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_g1" bpmnElement="g1"><omgdc:Bounds x="825" y="395" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_t4" bpmnElement="t4"><omgdc:Bounds x="945" y="65" width="110" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_t5" bpmnElement="t5"><omgdc:Bounds x="945" y="385" width="110" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_t6" bpmnElement="t6"><omgdc:Bounds x="1095" y="545" width="110" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_t7" bpmnElement="t7"><omgdc:Bounds x="1245" y="545" width="110" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_g2" bpmnElement="g2"><omgdc:Bounds x="1425" y="75" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_e1" bpmnElement="e1"><omgdc:Bounds x="1582" y="82" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ed_f_asis_complaint_1" bpmnElement="f_asis_complaint_1"><omgdi:waypoint x="268" y="100"/><omgdi:waypoint x="345" y="100"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_asis_complaint_2" bpmnElement="f_asis_complaint_2"><omgdi:waypoint x="455" y="100"/><omgdi:waypoint x="475" y="100"/><omgdi:waypoint x="475" y="260"/><omgdi:waypoint x="495" y="260"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_asis_complaint_3" bpmnElement="f_asis_complaint_3"><omgdi:waypoint x="605" y="260"/><omgdi:waypoint x="625" y="260"/><omgdi:waypoint x="625" y="420"/><omgdi:waypoint x="645" y="420"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_asis_complaint_4" bpmnElement="f_asis_complaint_4"><omgdi:waypoint x="755" y="420"/><omgdi:waypoint x="825" y="420"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_asis_complaint_5" bpmnElement="f_asis_complaint_5"><omgdi:waypoint x="875" y="420"/><omgdi:waypoint x="945" y="420"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_asis_complaint_6" bpmnElement="f_asis_complaint_6"><omgdi:waypoint x="875" y="420"/><omgdi:waypoint x="910" y="420"/><omgdi:waypoint x="910" y="100"/><omgdi:waypoint x="945" y="100"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_asis_complaint_7" bpmnElement="f_asis_complaint_7"><omgdi:waypoint x="1000" y="65"/><omgdi:waypoint x="1000" y="47"/><omgdi:waypoint x="700" y="47"/><omgdi:waypoint x="700" y="385"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_asis_complaint_8" bpmnElement="f_asis_complaint_8"><omgdi:waypoint x="1055" y="420"/><omgdi:waypoint x="1075" y="420"/><omgdi:waypoint x="1075" y="580"/><omgdi:waypoint x="1095" y="580"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_asis_complaint_9" bpmnElement="f_asis_complaint_9"><omgdi:waypoint x="1205" y="580"/><omgdi:waypoint x="1245" y="580"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_asis_complaint_10" bpmnElement="f_asis_complaint_10"><omgdi:waypoint x="1355" y="580"/><omgdi:waypoint x="1390" y="580"/><omgdi:waypoint x="1390" y="100"/><omgdi:waypoint x="1425" y="100"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ed_f_asis_complaint_11" bpmnElement="f_asis_complaint_11"><omgdi:waypoint x="1475" y="100"/><omgdi:waypoint x="1582" y="100"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
